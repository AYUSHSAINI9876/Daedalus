{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build (WSL)",
      "type": "shell",
      "command": "wsl.exe -d Ubuntu -- bash ./scripts/wsl-build.sh build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "test (WSL)",
      "type": "shell",
      "command": "wsl.exe -d Ubuntu -- bash ./scripts/wsl-build.sh test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "smoke test the server (WSL)",
      "type": "shell",
      "command": "wsl.exe -d Ubuntu -- bash ./scripts/wsl-build.sh smoke",
      "problemMatcher": []
    }
  ]
}
